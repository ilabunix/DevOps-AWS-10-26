(
  $alerts := $.data.groups.rules.alerts[
    state = "Alerting" and
    labels.application = "compass" and
    labels.environment = "uat"
  ];

  $critical := $alerts[
    $lowercase(labels.severity) = "critical" or
    $lowercase(labels.severity) = "high"
  ];

  $warning := $alerts[
    $lowercase(labels.severity) = "warning" or
    $lowercase(labels.severity) = "medium" or
    $lowercase(labels.severity) = "low"
  ];

  {
    "compass_alert_status":
      $count($critical) > 0 ? 2 :
      $count($warning) > 0 ? 1 :
      0
  }
)