(
  $matches := $.data.groups.rules.alerts[
    state = "Alerting" and
    labels.application = "compass"
  ];

  $matches ? $matches.{
    "name": labels.alertname,
    "job": labels.`compass-job`,
    "alert_type": labels.alert_type,
    "severity": labels.severity
  } : {
    "name": null,
    "job": null,
    "alert_type": null,
    "severity": null
  }
)