(
  $matches := $.data.groups.rules.alerts[
    state = "Alerting" and
    labels.application = "compass" and
    labels.environment = "uat"
  ];

  $matches ? $matches.{
    "name": labels.alertname,
    "job": $lookup(labels, "compass-job"),
    "severity": labels.severity
  } : {
    "name": null,
    "job": null,
    "severity": null
  }
)